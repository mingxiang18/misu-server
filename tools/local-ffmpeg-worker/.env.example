# SSH target that stores /mnt/misu/misu-server/user-file.
SSH_USER=root
SSH_HOST=192.168.50.194
SSH_PORT=22

# Optional. Leave empty to use the default ssh-agent / ~/.ssh config.
SSH_KEY=

# The backend ffmpeg task file is generated inside a container, so task paths
# look like /app/user-file/xxx. This worker maps them to the real Linux path.
CONTAINER_USER_FILE_ROOT=/app/user-file
REMOTE_USER_FILE_ROOT=/mnt/misu/misu-server/user-file

# Local temp files. Relative paths are resolved from this directory.
LOCAL_WORK_DIR=.work
POLL_INTERVAL=5
KEEP_LOCAL_WORK=0
DASHBOARD_PORT=18765

# macOS GPU encoder. Confirm with:
# ffmpeg -hide_banner -encoders | grep hevc_videotoolbox
VIDEO_ENCODER_ARGS="-c:v hevc_videotoolbox -tag:v hvc1 -pix_fmt yuv420p -q:v 55 -allow_sw 1"
AUDIO_BITRATE=128k

# Optional task handling.
MAX_TASK_RETRIES=1
