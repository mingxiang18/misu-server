{
  "name": "misu-file-server-ui",
  "version": "1.0.0",
  "description": "misu-file-server-ui",
  "main": "electron/main.js",
  "author": "misuaa",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently vite \"nodemon --exec electron . --watch ./ --ext .js,.html,.css,.vue\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "concurrently": "^9.0.1",
    "element-plus": "^2.8.6",
    "epubjs": "^0.3.93",
    "flv.js": "^1.6.2",
    "js-cookie": "^3.0.5",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^33.0.1",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.7",
    "vite": "^5.4.8",
    "vite-plugin-vue-devtools": "^7.4.6"
  },
  "build": {
    "appId": "misu-0001",
    "productName": "misuFileServerUI",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "electron-dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "文件服务器"
    }
  }
}
